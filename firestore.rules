rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alexjun2306@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Helpers
    function isValidIncident(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'address', 'latitude', 'longitude', 'reporterUid', 'status', 'createdAt']) &&
        data.title is string && data.title.size() <= 200 &&
        data.category in ['begal', 'kecelakaan', 'macet', 'banjir', 'demo', 'kebakaran', 'event', 'lainnya'] &&
        data.description is string && data.description.size() <= 2000 &&
        data.address is string && data.address.size() <= 300 &&
        data.latitude is number &&
        data.longitude is number &&
        data.reporterUid is string && data.reporterUid.size() <= 128 &&
        data.status in ['pending', 'verified', 'rejected', 'resolved'] &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidNews(data) {
      return data.keys().hasAll(['title', 'summary', 'content', 'category', 'authorUid', 'createdAt']) &&
        data.title is string && data.title.size() <= 250 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.content is string && data.content.size() <= 5000 &&
        data.category in ['event', 'darurat', 'lalulintas', 'lingkungan', 'himbauan'] &&
        data.authorUid is string && data.authorUid.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['reportId', 'authorUid', 'authorName', 'comment', 'createdAt']) &&
        data.reportId is string && data.reportId.size() <= 128 &&
        data.authorUid is string && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.comment is string && data.comment.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidAirQuality(data) {
      return data.keys().hasAll(['stationName', 'district', 'aqi', 'status', 'latitude', 'longitude']) &&
        data.stationName is string && data.stationName.size() <= 100 &&
        data.district is string && data.district.size() <= 100 &&
        data.aqi is number &&
        data.status in ['BAIK', 'SEDANG', 'TIDAK_SEHAT', 'SANGAT_TIDAK_SEHAT', 'BERBAHAYA'] &&
        data.latitude is number &&
        data.longitude is number;
    }

    // Incidents Collection
    match /incidents/{incidentId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        isValidId(incidentId) &&
        isValidIncident(incoming()) &&
        incoming().reporterUid == request.auth.uid &&
        (isAdmin() || (incoming().status == 'pending' && (!('isOfficial' in incoming()) || incoming().isOfficial == false)));

      allow update: if isSignedIn() &&
        isValidId(incidentId) &&
        (
          isAdmin() ||
          // Warga can upvote or reporter can update description if pending
          (existing().reporterUid == request.auth.uid && existing().status == 'pending' &&
           incoming().diff(existing()).affectedKeys().hasOnly(['description', 'address', 'updatedAt'])) ||
          // Upvote action
          (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes']))
        );

      allow delete: if isAdmin() || (isSignedIn() && existing().reporterUid == request.auth.uid && existing().status == 'pending');
    }

    // News Collection
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(newsId) && isValidNews(incoming());
      allow update: if isAdmin() && isValidId(newsId) && isValidNews(incoming());
      allow delete: if isAdmin();
    }

    // Air Quality Collection
    match /air_quality/{stationId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(stationId) && isValidAirQuality(incoming());
      allow delete: if isAdmin();
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming()) &&
        incoming().authorUid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(commentId) && isValidComment(incoming()) &&
        existing().authorUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['comment']);
      allow delete: if isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
